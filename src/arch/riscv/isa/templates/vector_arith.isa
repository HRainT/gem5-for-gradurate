    %(set_vlenb)s;
    %(set_vlen)s;
    %(vm_decl_rd)s;
    %(copy_old_vd)s;

    const uint32_t bit_offset = vlenb / sizeof(ElemType);
    const uint32_t offset = bit_offset * microIdx;

    %(code)s;
    %(op_wb)s;
    return NoFault;
}

%(declare_varith_template)s;

}};

