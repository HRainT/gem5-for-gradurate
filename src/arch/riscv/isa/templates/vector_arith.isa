def template RxuVectorSlideUpMacroConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst, uint32_t _vlen)
    : Special%(base_class)s("%(mnemonic)s", _machInst, %(op_class)s, _vlen)
{
    %(set_reg_idx_arr)s;
    _numSrcRegs = 0;
    _numDestRegs = 0;
    setDestRegIdx(_numDestRegs++, vecRegClass[_machInst.vd]);
    _numTypedDestRegs[VecRegClass]++;
    %(set_macro_src)s;
    const uint32_t num_microops = vtype_regs_per_group(vtype);
    int32_t tmp_vl = this->vl;
    const int32_t micro_vlmax = vtype_VLMAX(_machInst.vtype8, vlen, true);
    int32_t micro_vl = std::min(tmp_vl, micro_vlmax);
    StaticInstPtr microop;
    this->flags[IsSpecialVector] = true;

    if (micro_vl == 0) {
        setSrcRegIdx(_numSrcRegs++, vecRegClass[_machInst.vs2]);
        setSrcRegIdx(_numSrcRegs++, vecRegClass[_machInst.vd]);
        microop = new VectorNopMicroInst(_machInst);
        this->microops.push_back(microop);
        this->microops.front()->setFirstMicroop();
        this->microops.back()->setLastMicroop();
        return;
    }
    // Todo static filter out useless uop
    int micro_idx = 0;
    for (int i = 0; i < num_microops && micro_vl > 0; ++i) {
        setSrcRegIdx(_numSrcRegs++, vecRegClass[_machInst.vs2 + i]);
        setSrcRegIdx(_numSrcRegs++, vecRegClass[_machInst.vd + i]);
        microop = new %(class_name)sMicro<ElemType>(
            _machInst, micro_vl, micro_idx++, i, i);
        microop->setDelayedCommit();
        this->microops.push_back(microop);
        micro_vl = std::min(tmp_vl -= micro_vlmax, micro_vlmax);
    }
    if (!_machInst.vm)
        setSrcRegIdx(_numSrcRegs++, vecRegClass[0]);
    this->microops.front()->setFirstMicroop();
    this->microops.back()->setLastMicroop();
}

%(declare_varith_template)s;

}};

def template VectorFloatSlideUpMacroConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst, uint32_t _vlen)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s, _vlen)
{
    %(set_reg_idx_arr)s;
    setDestRegIdx(_numDestRegs++, vecRegClass[VD]);
    _numTypedDestRegs[vecRegClass.type()]++;
    setSrcRegIdx(_numSrcRegs++, ((RS1) == 0) ? RegId() : floatRegClass[RS1]);
    setSrcRegIdx(_numSrcRegs++, vecRegClass[VS2]);
    flags[IsInteger] = true;
    flags[IsVector] = true;;
    const uint32_t num_microops = vtype_regs_per_group(vtype);
    int32_t tmp_vl = this->vl;
    const int32_t micro_vlmax = vtype_VLMAX(_machInst.vtype8, vlen, true);
    int32_t micro_vl = std::min(tmp_vl, micro_vlmax);
    StaticInstPtr microop;

    if (micro_vl == 0) {
        microop = new VectorNopMicroInst(_machInst);
        this->microops.push_back(microop);
    }
    // Todo static filter out useless uop
    int micro_idx = 0;
    for (int i = 0; i < num_microops && micro_vl > 0; ++i) {
        for (int j = 0; j <= i; ++j) {
            microop = new %(class_name)sMicro<ElemType>(
                _machInst, micro_vl, micro_idx++, i, j);
            microop->setDelayedCommit();
            this->microops.push_back(microop);
        }
        micro_vl = std::min(tmp_vl -= micro_vlmax, micro_vlmax);
    }
    this->microops.front()->setFirstMicroop();
    this->microops.back()->setLastMicroop();
}

%(declare_varith_template)s;

}};

