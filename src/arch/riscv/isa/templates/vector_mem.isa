def template VluxSegRxuUopConstructor {{

    template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst, uint32_t _vlen, 
    uint32_t _field, uint64_t _seqNum, uint32_t _micro_vl, uint32_t _vdRegIdx, 
    std::deque<uint32_t> _vdElemIdx,uint32_t _vs2RegIdx, std::deque<uint32_t> _vs2ElemIdx)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s, _vlen,_field, _micro_vl, _seqNum,
     _vdRegIdx, _vdElemIdx, _vs2RegIdx, _vs2ElemIdx)
{
    %(set_reg_idx_arr)s;
    %(constructor)s;

    int eleNum = _vdElemIdx.size();
    uint32_t vdRegIdx = _vdRegIdx;
    uint32_t vs2RegIdx = _vs2RegIdx;

    const uint32_t vd_eewb = sizeof(ElemType);
