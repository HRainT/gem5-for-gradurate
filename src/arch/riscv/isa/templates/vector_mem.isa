def template VlStrideRxuUopConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst, uint32_t _vlen, uint32_t _regIdx, 
                                std::deque<uint32_t> _microIdx_q, uint32_t _microVl, uint64_t _seqNum)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s, _vlen,  _regIdx,  _microIdx_q, _seqNum, _microVl)
{
    %(set_reg_idx_arr)s;
    %(constructor)s;

    int eleNum = _microIdx_q.size();
    uint32_t regIdx = _regIdx;
    uint32_t micro_vl = _microVl;
    uint64_t seqNum = _seqNum;
    StaticInstPtr microop;

    for (int j = 0; j < eleNum; ++j) {
        uint32_t microIdx = _microIdx_q.front();
        _microIdx_q.pop_front();
        microop = new %(class_name)sMicro<ElemType>(machInst, regIdx, microIdx, micro_vl, seqNum);
        microop->setFlag(IsDelayedCommit);
        microop->setFlag(IsLoad);
        this->microops.push_back(microop);
    }
    this->microops.front()->setFlag(IsFirstMicroop);
    this->microops.back()->setFlag(IsLastMicroop);
    this->flags[IsVector] = true;
}

