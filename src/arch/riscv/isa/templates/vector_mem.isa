def template VsIndexRxuUopConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst, uint32_t _vlen,
            uint32_t _vs3RegIdx, std::deque<uint32_t> _vs3ElemIdx,
            uint32_t _vs2RegIdx, std::deque<uint32_t> _vs2ElemIdx,
            uint64_t _seqNum)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s, _vlen,
            _vs3RegIdx, _vs3ElemIdx, _vs2RegIdx, _vs2ElemIdx, _seqNum)
{
    %(set_reg_idx_arr)s;
    %(constructor)s;

    StaticInstPtr microop;

    int elemNum = _vs3ElemIdx.size();
    uint32_t vs3RegIdx = _vs3RegIdx;
    uint32_t vs2RegIdx = _vs2RegIdx;

    for (uint32_t j = 0; j < elemNum; ++j) {
        uint32_t vs3ElemIdx = _vs3ElemIdx.front();
        uint32_t vs2ElemIdx = _vs2ElemIdx.front();
        _vs3ElemIdx.pop_front();
        _vs2ElemIdx.pop_front();
        microop = new %(class_name)sMicro<ElemType>(machInst,
            vs3RegIdx, vs3ElemIdx, vs2RegIdx, vs2ElemIdx, seqNum);
        microop->setFlag(IsDelayedCommit);
        microop->setFlag(IsStore);
        if(_machInst.mop == 0x3)
            microop->setFlag(IsOrder);
        this->microops.push_back(microop);
    }

    this->microops.front()->setFlag(IsFirstMicroop);
    this->microops.back()->setFlag(IsLastMicroop);
    this->flags[IsVector] = true;
}

%(declare_vmem_template)s;

}};

