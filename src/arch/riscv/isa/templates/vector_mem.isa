    panic_if((pow(2, vlmul) * this->numFields) > 8,
        "LMUL value is illegal for vsseg inst");

    RiscvISA::vreg_t tmp_v0;
    uint8_t *v0;
    if(!machInst.vm) {
        xc->getRegOperand(this, _numSrcRegs - 1, &tmp_v0);
        v0 = tmp_v0.as<uint8_t>();
    }

