    def template VlSegRxuUopConstructor {{
        template<typename ElemType>
        %(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst, uint32_t _vlen, 
            uint32_t _field, uint32_t _microIdx,
            uint64_t _seqNum, std::deque<uint32_t> _elemIdx_q,
             uint32_t _micro_vl, std::deque<uint32_t> _seg_regidx_q, std::deque<uint32_t> _seg_elemidx_q)
            : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s, _vlen, _field, _microIdx, _seqNum)
        {
            %(set_reg_idx_arr)s;
            %(constructor)s;
            
            int eleNum = _elemIdx_q.size();
            const int32_t micro_vlmax = vlen / width_EEW(_machInst.width);
            const uint32_t num_microops = ceil((float) this->vl / (micro_vlmax));
            int32_t remaining_vl = this->vl;
        
            uint32_t micro_vl = _micro_vl;
            uint32_t microIdx = _microIdx;
            uint32_t field = _field;
            size_t NFIELDS = machInst.nf + 1;
            StaticInstPtr microop;
            uint32_t size_per_elem = width_EEW(_machInst.width) / 8;
        
                for (int i = 0; i < eleNum; ++i) {
                    uint32_t elemIdx = _elemIdx_q.front();
                    _elemIdx_q.pop_front();
                    uint32_t seg_regidx = _seg_regidx_q.front();
                    _seg_regidx_q.pop_front();
                    int64_t intermediate = static_cast<int64_t>(seg_regidx) - static_cast<int64_t>(microIdx) - static_cast<int64_t>(field) * static_cast<int64_t>(num_microops);
                    intermediate *= 17;
                    int64_t result = intermediate + static_cast<int64_t>(_seqNum); 
                    uint64_t rel_sn = static_cast<uint64_t>(result); 
                    uint32_t seg_elemidx = _seg_elemidx_q.front();
                    _seg_elemidx_q.pop_front();
                    microop = new %(class_name)sMicro<ElemType>(_machInst, micro_vl, microIdx, num_microops, field, NFIELDS, vlen,
                         elemIdx, rel_sn, seg_elemidx);
                    microop->setDelayedCommit();
                    microop->setFlag(IsLoad);
                    this->microops.push_back(microop);
                }

        
            this->microops.front()->setFlag(IsFirstMicroop);
            this->microops.back()->setFlag(IsLastMicroop);
            this->flags[IsVector] = true;
        }
        %(declare_vmem_template)s;
