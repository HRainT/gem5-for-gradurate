def template VsIndexSegRxuUopMicroConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(
    ExtMachInst _machInst,uint32_t _vs3RegIdx, uint32_t _vs3ElemIdx,
    uint32_t _vs2RegIdx, uint32_t _vs2ElemIdx, uint64_t _seqNum, uint32_t _numMicroops, uint32_t _field, uint32_t _numFields)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s,
        _vs3RegIdx, _vs3ElemIdx, _vs2RegIdx, _vs2ElemIdx, _seqNum, _numMicroops, _field, _numFields)
{
