    uint32_t micro_vl = _micro_vl;
    uint32_t field = _field;
    size_t NFIELDS = machInst.nf + 1;
    StaticInstPtr microop;

        for (int i = 0; i < eleNum; ++i) {
            uint32_t vdElemIdx = _vdElemIdx.front();
            uint32_t vs2ElemIdx = _vs2ElemIdx.front();
            _vdElemIdx.pop_front();
            _vs2ElemIdx.pop_front();
            microop = new %(class_name)sMicro<ElemType>(_machInst, micro_vl,
                num_microops, field, NFIELDS, vlen, vdRegIdx, vdElemIdx, vs2RegIdx, vs2ElemIdx, _seqNum);
            microop->setDelayedCommit();
            microop->setFlag(IsLoad);
            if(_machInst.mop == 0x3)
                microop->setFlag(IsOrder);
            this->microops.push_back(microop);
        }

    this->microops.front()->setFlag(IsFirstMicroop);
    this->microops.back()->setFlag(IsLastMicroop);
    this->flags[IsVector] = true;
}
