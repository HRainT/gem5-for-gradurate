def template VsStrideSegRxuUopConstructor {{

%(class_name)s::%(class_name)s(ExtMachInst _machInst, uint32_t _microVl, uint32_t _regIdx, 
                std::deque<uint32_t> _microIdx_q, uint32_t _numMicroops, uint32_t _field,
                uint32_t _numFields, uint64_t _seqNum, uint32_t _vlen)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s, _microVl,  _regIdx,
        _microIdx_q, _numMicroops, _field, _numFields, _seqNum, _vlen)
{
    %(set_reg_idx_arr)s;
    %(constructor)s;

    int eleNum = _microIdx_q.size();
    uint32_t regIdx = _regIdx;
    uint32_t micro_vl = _microVl;
    uint64_t seqNum = _seqNum;
    uint32_t field = _field;
    uint32_t numFields = _numFields;
    uint32_t numMicroops = _numMicroops;
    StaticInstPtr microop;

    if (micro_vl == 0) {
        microop = new VectorNopMicroInst(_machInst);
        this->microops.push_back(microop);
    }
    for (int j = 0; j < eleNum; ++j) {
        uint32_t microIdx = _microIdx_q.front();
        _microIdx_q.pop_front();
        microop = new %(class_name)sMicro(machInst, micro_vl, regIdx, microIdx, 
            numMicroops, field, numFields, seqNum);
        microop->setFlag(IsDelayedCommit);
        microop->setFlag(IsStore);
        this->microops.push_back(microop);
    }

    this->microops.front()->setFlag(IsFirstMicroop);
    this->microops.back()->setFlag(IsLastMicroop);
    this->flags[IsVector] = true;
}

}};

